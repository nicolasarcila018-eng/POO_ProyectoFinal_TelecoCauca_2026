{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "compilacion separada en c++ ",
			"command": "C:\\MinGW\\bin\\g++.exe",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${workspaceFolder}/src/*.cpp",
				"-I",
				"${workspaceFolder}/include",
				"-o",
				"${workspaceFolder}\\${fileBasenameNoExtension}.exe",
				"-std=c++17",
				"-Wall",
				"-Wextra",
				"-lws2_32"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: C:\\MinGW\\bin\\g++.exe"
		},
		{
			"label": "compilar y ejecutar archivo actual con g++",
			"command": "${workspaceFolder}\\${fileBasenameNoExtension}.exe",
			"dependsOn": "compilacion separada en c++ ",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
